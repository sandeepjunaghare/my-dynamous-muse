# Get your Open AI API Key by following these instructions -
# https://help.openai.com/en/articles/4936850-where-do-i-find-my-openai-api-key
OPENAI_API_KEY=

# Below variables are for V2 and beyond:

# The LLM to use, for both chat replies and Mem0's memory extraction
# (defaults to gpt-4o-mini)
MODEL_CHOICE=gpt-4o-mini

# The Postgres connection string Mem0 uses as its vector store. Required by
# v2-supabase-mem0.py, which fails at startup if it is unset.
#
# Local stack (what these scripts target by default):
#   postgresql://postgres:your-password@127.0.0.1:5432/postgres
#
# Hosted Supabase - Database section of your project settings:
# https://supabase.com/dashboard/project/<your project ID>/settings/database
# Replace the [YOUR-PASSWORD] placeholder with the DB password you set when
# creating the account; you can reset it on that same page.
#
# URL-encode any special characters in the password ('@' is %40, '?' is %3F).
DATABASE_URL=

# Supabase configuration for authentication
# Get these from your Supabase project settings -> API
# https://supabase.com/dashboard/project/<your project ID>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Get your Mem0 API key from https://app.mem0.ai (used by mem0helloworld.py)
MEM0_API_KEY=
