{
  "//": "V29 demo hooks — copy into the AI Tutor's .claude/settings.json (merge the hooks block).",
  "//2": "Scripts go to .claude/hooks/ in the AI Tutor. All three were briefed via hooks-create on camera;",
  "//3": "these files are the prepared result so recording day has no surprises.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-touched.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/baton.sh",
            "async": true
          }
        ]
      }
    ]
  }
}
