# Local Prospect Engine — every variable the service reads. Copy to `.env` and fill in.
# `.env` is never committed. Config is strict 12-factor: no local paths here, so moving from a
# local Mac to a small VPS is a change to these values and nothing else.
#
# `extra="forbid"` is set on Settings, so a line in your `.env` that is not listed below will
# fail startup rather than being silently ignored — a typo is a loud error, by design. (The
# check covers `.env`, not the whole process environment, which holds PATH and everything else.)

# --- Application -------------------------------------------------------------------------------
APP_NAME=local-prospect-engine
VERSION=0.1.0
# dev | prod — one hosted Supabase project per environment.
ENVIRONMENT=dev
DEBUG=false

# --- Database (required) -----------------------------------------------------------------------
# Hosted Supabase, via the SESSION-mode pooler. Three things about this URL are deliberate:
#
#   1. The `postgresql+asyncpg://` scheme, not `postgresql://`. The application and Alembic both
#      run on an async engine; the bare scheme selects the sync driver and fails at connect.
#
#   2. The pooler host, not `db.<project-ref>.supabase.co`. Supabase made direct connections
#      IPv6-only for projects created after early 2024, and IPv4 there is a paid add-on. On a
#      network without IPv6 the direct host does not even resolve — the symptom is
#      `socket.gaierror: nodename nor servname provided`, which reads like a typo and is not one.
#
#   3. Port 5432 — the pooler's SESSION mode — never 6543, its TRANSACTION mode. This is the part
#      that matters and the reason the two ports are not interchangeable:
#
#        - Session mode (5432) holds one dedicated server connection for the life of the client
#          session, so asyncpg's prepared statements survive. It behaves like a direct connection.
#        - Transaction mode (6543) hands the connection back after every transaction, so prepared
#          statements do not survive. The failure is intermittent and load-dependent: it passes
#          local testing and fails during the weekly run with DuplicatePreparedStatementError.
#
#      If 6543 is ever genuinely required it needs BOTH `connect_args={"statement_cache_size": 0}`
#      and `prepared_statement_cache_size=0` on the engine in app/core/database.py. Neither alone
#      is sufficient. Session mode needs neither, which is why we are on it.
#
#   Note the username: the pooler needs `postgres.<project-ref>`, not bare `postgres`.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# --- Observability -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Cost --------------------------------------------------------------------------------------
# A circuit breaker against a runaway loop, not a budget target (D9). Per-run cost is measured and
# logged from T1 onward so the first real run sets the ceiling instead of a guess.
MAX_PLACES_CALLS_PER_RUN=500

# --- Integrations ------------------------------------------------------------------------------
# HubSpot private app token (portal 244766495). Optional at startup — the service and `/health`
# boot without it — but the gateway raises ConfigurationError naming this variable the first time
# anything asks for a client. Left blank here on purpose; blank is treated as missing.
#
# The private app needs exactly these scopes:
#   crm.objects.contacts.read     crm.objects.contacts.write
#   crm.objects.companies.read    crm.objects.companies.write
#   crm.objects.deals.read        (T10's Friday report only — nothing writes deals)
#   crm.schemas.companies.write   crm.schemas.contacts.write   (custom property provisioning)
#
# There is no `crm.objects.tasks.*` scope and you will not find one: engagement objects, tasks
# included, are gated behind the **contacts** scopes above. Confirmed twice in HubSpot's own docs.
HUBSPOT_PRIVATE_APP_TOKEN=

# The HubSpot owner id cadence tasks are assigned to when no owner is named — a founder's, so the
# tasks land in their "My tasks". Find it under Settings → Users & Teams, or the owners API. Left
# blank, tasks are created unassigned (nobody's queue, which is how E15's 22 tasks went unworked),
# and every enrol and sync warns about it.
HUBSPOT_DEFAULT_OWNER_ID=

# --- Manifest-authoring agent (T12: `lpe manifest propose`) ------------------------------------
# Optional. When blank, the Claude Agent SDK uses whatever credential its bundled CLI resolves.
ANTHROPIC_API_KEY=
# The model the research loop runs on. Defaults to the latest, most capable Claude model.
MANIFEST_AGENT_MODEL=claude-opus-5-5
# Circuit breakers for one proposal run — not budget targets. First live run: 36 turns, $0.78.
MANIFEST_AGENT_MAX_TURNS=60
MANIFEST_AGENT_MAX_BUDGET_USD=5.0

# --- classify_rollup judgment node (T7) ----------------------------------------------------------
# One call per candidate decides every judgment rule (~$0.08, measured on Opus). Circuit breakers:
# per call (turns, dollars) and per run (calls) — not budget targets.
ROLLUP_CLASSIFIER_MODEL=claude-opus-5-5
ROLLUP_CLASSIFIER_MAX_TURNS=8
ROLLUP_CLASSIFIER_MAX_BUDGET_USD=0.50
MAX_JUDGMENT_CALLS_PER_RUN=500
