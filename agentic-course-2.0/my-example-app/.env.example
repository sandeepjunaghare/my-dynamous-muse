# Local Prospect Engine — every variable the service reads. Copy to `.env` and fill in.
# `.env` is never committed. Config is strict 12-factor: no local paths here, so moving from a
# local Mac to a small VPS is a change to these values and nothing else.
#
# `extra="forbid"` is set on Settings, so a line in your `.env` that is not listed below will
# fail startup rather than being silently ignored — a typo is a loud error, by design. (The
# check covers `.env`, not the whole process environment, which holds PATH and everything else.)

# --- Application -------------------------------------------------------------------------------
APP_NAME=local-prospect-engine
VERSION=0.1.0
# dev | prod — one hosted Supabase project per environment.
ENVIRONMENT=dev
DEBUG=false

# --- Database (required) -----------------------------------------------------------------------
# Hosted Supabase. Two things about this URL are deliberate:
#
#   1. The `postgresql+asyncpg://` scheme, not `postgresql://`. The application and Alembic both
#      run on an async engine; the bare scheme selects the sync driver and fails at connect.
#
#   2. Port 5432 — Supabase's DIRECT connection — not 6543, the pooled one. The pooler is PgBouncer
#      in transaction mode, which does not hold a session long enough for asyncpg's prepared
#      statements to survive. The symptom is an intermittent, load-dependent
#      DuplicatePreparedStatementError: it passes local testing and fails during the weekly run.
#      One user and one weekly run need no pooler, so we take the direct port and avoid the class
#      of problem entirely.
#
#      If the pooled port is ever genuinely required, it needs BOTH
#      `connect_args={"statement_cache_size": 0}` and `prepared_statement_cache_size=0` on the
#      engine in app/core/database.py. Neither alone is sufficient.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Observability -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Cost --------------------------------------------------------------------------------------
# A circuit breaker against a runaway loop, not a budget target (D9). Per-run cost is measured and
# logged from T1 onward so the first real run sets the ceiling instead of a guess.
MAX_PLACES_CALLS_PER_RUN=500

# --- Integrations ------------------------------------------------------------------------------
# Optional until T3 wires the HubSpot gateway. Private app token, scoped to
# contacts/companies/deals/tasks read+write.
# HUBSPOT_PRIVATE_APP_TOKEN=
